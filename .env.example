# Supabase project URL (Project Settings > API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable (anon) key. Safe in the browser: every rule is enforced by RLS.
# NEVER put the service-role / secret key in any VITE_ variable.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
# true = SOS opens a demo modal instead of dialling 999. Keep true for every demo/test deploy.
VITE_DEMO_MODE=true
# here | leaflet (phase 3). Falls back automatically if HERE fails.
VITE_MAP_PROVIDER=here
# HERE Maps JS API key (phase 3). Restrict it to your domains in the HERE portal.
VITE_HERE_API_KEY=
